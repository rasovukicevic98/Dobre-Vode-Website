---
import { headerTranslations } from "../i18n/header";

const pathname = Astro.url.pathname;

const isEn = pathname === "/en" || pathname.startsWith("/en/");
const currentLang = isEn ? "en" : "me";
const otherLang = currentLang === "me" ? "en" : "me";

const t = headerTranslations[currentLang];

const cleanPath = pathname.replace(/^\/(me|en)(\/|$)/, "/");
const switchTo = cleanPath === "/" ? `/${otherLang}` : `/${otherLang}${cleanPath}`;

const navItems = [
  { label: t.about,   href: `/${currentLang}` },
  { label: t.menu,    href: `/${currentLang}/menu` },
  { label: t.contact, href: `/${currentLang}/contact` },
];

function isActive(href: string): boolean {
  const root = `/${currentLang}`;
  if (href === root) return pathname === root || pathname === root + "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<header class="sticky top-0 z-50 px-4 sm:px-6 pt-4 pb-3">
  <div
    class="
      mx-auto max-w-2xl
      bg-gradient-to-b from-[#5c3317] to-[#2b1a0a]
      rounded-2xl
      border border-[#7a4520]/70
      shadow-[0_8px_32px_rgba(0,0,0,0.65),inset_0_1px_0_rgba(255,255,255,0.09)]
    "
  >
    <div
      class="h-14 flex items-center justify-between px-5 sm:px-8"
    >

      <!-- Restaurant name -->
      <a
        href={`/${currentLang}`}
        class="text-[#f1e3d1] text-xs sm:text-sm font-bold tracking-widest uppercase hover:text-white transition-colors whitespace-nowrap"
      >
        Dobre Vode
      </a>

      <!-- Nav links -->
      <nav class="flex gap-5 sm:gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={
              "text-xs sm:text-sm uppercase tracking-wider font-semibold transition-colors duration-200 " +
              (isActive(item.href)
                ? "text-[#f1e3d1]"
                : "text-[#f1e3d1]/50 hover:text-[#f1e3d1]/85")
            }
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Language switcher -->
      <a
        href={switchTo}
        class="text-xs font-bold tracking-widest uppercase text-[#f1e3d1]/50 hover:text-[#f1e3d1] transition-colors"
      >
        {otherLang.toUpperCase()}
      </a>

    </div>
  </div>
</header>
