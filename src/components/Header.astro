---
const navItems = [
  { label: "About Us", href: "/about" },
  { label: "Menu", href: "/menu" },
  { label: "Contact", href: "/contact" },
];
---
<header class="mt-8 mb-6">
  <!-- NAV WRAPPER WITH SAFE HORIZONTAL PADDING -->
  <nav class="flex justify-center px-6 sm:px-8">
    <div class="flex gap-4 sm:gap-8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="
            px-4 sm:px-6
            py-2 sm:py-3
            min-w-[88px] sm:min-w-[100px]

            bg-gradient-to-b
            from-[#3f2a16]
            to-[#2b1b0e]

            text-[#f1e3d1]
            uppercase
            tracking-wider
            text-xs sm:text-sm
            font-semibold
            text-center
            whitespace-nowrap

            rounded-md
            border
            border-black/40

            shadow-[inset_0_1px_0_rgba(255,255,255,0.15),0_6px_12px_rgba(0,0,0,0.7)]

            transition-all
            duration-200

            hover:from-[#4a321c]
            hover:to-[#352313]
            hover:text-[#fff1df]
            hover:-translate-y-0.5

            active:translate-y-0
          "
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
