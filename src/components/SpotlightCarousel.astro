---
const { items } = Astro.props;
---
<!-- ======================= CAROUSEL ======================= -->
<div class="spotlight-carousel-wrapper">
  <div class="spotlight-carousel" id="carousel">
    <div class="carousel-item">
      <img src="/images/spec1.jpg" alt="" />
      <div class="carousel-caption">{items.dobreVodeSpecialty.name}</div>
    </div>

    <div class="carousel-item">
      <img src="/images/kolasinskistek.jpeg" alt="" />
      <div class="carousel-caption">{items.kolasinSteak.name}</div>
    </div>

    <div class="carousel-item">
      <img src="/images/telecepecenje.jpeg" alt="" />
      <div class="carousel-caption">{items.roastedVeal.name}</div>
    </div>

    <div class="carousel-item">
      <img src="/images/kacamak.jpeg" alt="" />
      <div class="carousel-caption">{items.potatoKacamak.name}</div>
    </div>

    <div class="carousel-item">
      <img src="/images/cicvara.jpeg" alt="" />
      <div class="carousel-caption">{items.cicvara.name}</div>
    </div>
  </div>
</div>

<style>
.spotlight-carousel-wrapper {
  position: relative;
  overflow: hidden;
  padding-inline: 70px;
}

.spotlight-carousel {
  position: relative;
  height: 390px;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}

.carousel-item {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: default;
  pointer-events: none; /* 🔒 click disabled */
  transition:
    transform 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.3s ease,
    filter 0.3s ease;
}

.carousel-item img {
  width: 240px;
  height: 320px;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
}

.carousel-caption {
  margin-top: 0.75rem;
  font-family: serif;
  font-size: 0.95rem;
  color: #2a1d13;
  opacity: 0.9;
}

@media (max-width: 640px) {
  .carousel-item img {
    width: 210px;
    height: 290px;
  }

  .spotlight-carousel-wrapper {
    padding-inline: 40px;
  }
}
</style>

<script>
  const carousel = document.getElementById("carousel");
  const items = [...carousel.querySelectorAll(".carousel-item")];
  const totalItems = items.length;

  // Start from the center item
  let activeIndex = Math.floor(totalItems / 2);

  function distance() {
    return window.innerWidth < 640 ? 120 : 260;
  }

  function mod(n, m) {
    return ((n % m) + m) % m;
  }

  function update() {
    const d = distance();
    const half = Math.floor(totalItems / 2);

    items.forEach((item, i) => {
      // ✅ bullet-proof circular offset
      const offset =
        ((i - activeIndex + totalItems + half) % totalItems) - half;

      const absOffset = Math.abs(offset);
      const isActive = offset === 0;

      let scale;
      if (isActive) {
        scale = 1;
      } else if (absOffset === 1) {
        scale = window.innerWidth < 640 ? 0.9 : 0.82;
      } else {
        scale = window.innerWidth < 640 ? 0.8 : 0.7;
      }

      item.style.transform =
        `translateX(${offset * d}px) scale(${scale})`;

      item.style.opacity =
        absOffset === 0 ? "1" :
        absOffset === 1 ? "0.45" :
        "0";

      item.style.filter =
        isActive ? "brightness(1)" : "brightness(0.7)";

      item.style.zIndex =
        isActive ? "20" :
        absOffset === 1 ? "10" : "5";
    });
  }

  function next() {
    activeIndex = mod(activeIndex + 1, totalItems);
    update();
  }

  function prev() {
    activeIndex = mod(activeIndex - 1, totalItems);
    update();
  }

  /* ===================== TOUCH SWIPE ===================== */
  let startX = null;

  carousel.addEventListener("touchstart", (e) => {
    startX = e.touches[0].clientX;
  });

  carousel.addEventListener("touchend", (e) => {
    if (startX === null) return;
    const diff = startX - e.changedTouches[0].clientX;
    if (diff > 50) next();
    if (diff < -50) prev();
    startX = null;
  });

  /* ===================== KEYBOARD ===================== */
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") next();
    if (e.key === "ArrowLeft") prev();
  });

  window.addEventListener("resize", update);
  update();
</script>
