---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { translations } from "../../i18n/translations";

const t = translations.me.contact;
---

<BaseLayout title="Kontakt – Dobre Vode">
  <Header />

  <main class="mt-12 mb-24 px-4">
    <section
      class="
        relative w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl xl:max-w-2xl
        mx-auto rounded-xl bg-[#f3e6cf]
        shadow-[0_20px_70px_rgba(0,0,0,0.6)]
        border border-black/10 text-center
      "
    >
      <div class="px-8 sm:px-10 md:px-12 lg:px-16 py-16 sm:py-20">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl mb-14 tracking-wide text-[#7a1f1f]">
          {t.title}
        </h1>

        <div class="space-y-8 text-[#3a2818] text-lg">
          <div>
            <p class="font-semibold mb-1">{t.phone}</p>
            <a href="tel:+38267233000">+382 67 233 000</a>
          </div>

          <div>
            <p class="font-semibold mb-1">{t.email}</p>
            <a href="mailto:dobrevodekolasin@gmail.com">
              dobrevodekolasin@gmail.com
            </a>
          </div>

          <div>
            <p class="font-semibold mb-4">{t.location}</p>
            <iframe
              class="w-full h-[300px] rounded-lg"
              src="https://www.google.com/maps?q=42.88834376187423,19.53937941335553&z=15&output=embed"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
