---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { translations } from "../../i18n/translations";

const t = translations.me.home;
---

<BaseLayout title="Dobre Vode">
  <Header />

  <main class="mt-12 mb-24 px-4">
    <section
      class="
        relative w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl xl:max-w-2xl
        mx-auto rounded-xl bg-[#f3e6cf]
        shadow-[0_20px_70px_rgba(0,0,0,0.6)]
        border border-black/10 text-center
      "
    >
      <div class="px-8 sm:px-10 md:px-12 lg:px-16 py-16 sm:py-20">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl tracking-wide mb-14 text-[#7a1f1f] font-renfrew">
          {t.title}
        </h1>

        <img
          src="/images/spec2.jpg"
          alt="Restaurant atmosphere"
          class="lightbox-img w-full rounded-lg shadow-[0_10px_30px_rgba(0,0,0,0.4)] border border-black/10 mb-20 cursor-pointer"
        />

        <div class="space-y-9 text-[#3a2818] text-base sm:text-lg lg:text-xl leading-relaxed font-light">
          <p class="italic text-lg sm:text-xl lg:text-2xl text-[#2a1d13]/90">
            {t.welcome}
          </p>

          <p>{t.p1}</p>
          <p>{t.p2}</p>

          <p class="pt-12 font-medium text-[#2a1d13] text-lg sm:text-xl lg:text-2xl">
            {t.thanks}
          </p>
        </div>

        <!-- IMAGES -->
        <div class="mt-16 flex flex-col gap-10">
          <img src="/images/spec1.jpg" class="lightbox-img image" />
          <img src="/images/rest1.jpeg" class="lightbox-img image" />
          <img src="/images/sala1.jpeg" class="lightbox-img image" />
          <img src="/images/rest2.jpeg" class="lightbox-img image" />
        </div>
      </div>
    </section>
  </main>

  <!-- LIGHTBOX -->
  <div id="lightbox" class="lightbox hidden">
    <div class="lightbox-backdrop"></div>

    <div class="lightbox-content">
      <button id="lightbox-close" aria-label="Close image">✕</button>
      <img id="lightbox-image" src="" alt="Preview" />
    </div>
  </div>
</BaseLayout>

<style>
/* ================= LIGHTBOX ================= */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;
}

.lightbox.hidden {
  display: none;
}

.lightbox-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
}

.lightbox-content {
  position: relative;
  z-index: 2;
  max-width: 90vw;
  max-height: 90vh;
  margin: auto;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.lightbox-content img {
  max-width: 100%;
  max-height: 90vh;
  border-radius: 0.75rem;
  box-shadow: 0 20px 60px rgba(0,0,0,.8);
}

#lightbox-close {
  position: absolute;
  top: -12px;
  right: -12px;
  background: #2a1d13;
  color: #f3e6cf;
  border: none;
  font-size: 1.25rem;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(0,0,0,.6);
}

#lightbox-close:hover {
  background: #7a1f1f;
}

.lightbox-img {
  cursor: zoom-in;
}
</style>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-image");
  const closeBtn = document.getElementById("lightbox-close");
  const backdrop = document.querySelector(".lightbox-backdrop");

  document.querySelectorAll(".lightbox-img").forEach(img => {
    img.addEventListener("click", () => {
      lightboxImg.src = img.src;
      lightbox.classList.remove("hidden");
    });
  });

  function closeLightbox() {
    lightbox.classList.add("hidden");
    lightboxImg.src = "";
  }

  closeBtn.addEventListener("click", closeLightbox);
  backdrop.addEventListener("click", closeLightbox);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>
