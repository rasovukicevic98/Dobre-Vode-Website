<style>
/* =================== CAROUSEL =================== */
.spotlight-carousel {
  position: relative;
  height: 360px;
  margin-bottom: 4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;

  /* 🔑 FIX */
  touch-action: pan-y;
  overscroll-behavior: contain;
  user-select: none;
}

.carousel-item {
  position: absolute;
  transition:
    transform 0.45s ease,
    opacity 0.45s ease,
    filter 0.45s ease;
  cursor: pointer;
}

.carousel-item img {
  width: 240px;
  height: 320px;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 18px 40px rgba(0,0,0,.45);

  /* 🔑 FIX */
  -webkit-user-drag: none;
  user-select: none;
  pointer-events: none;
}

@media (max-width: 640px) {
  .carousel-item img {
    width: 210px;
    height: 290px;
  }
}

/* =================== MENU =================== */
summary {
  list-style: none;
  cursor: pointer;
}

summary::-webkit-details-marker {
  display: none;
}

details > summary {
  -webkit-appearance: none;
  appearance: none;
}

.menu-group {
  margin-bottom: 3rem;
  contain: layout paint;
}

.menu-summary {
  position: relative;
  padding-left: 2rem;
  font-size: 1.5rem;
  font-family: serif;
  color: #2a1d13;
}

.menu-summary::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  border-top: 7px solid transparent;
  border-bottom: 7px solid transparent;
  border-left: 10px solid #5b3a1e;
  transition: transform .25s ease;
}

details[open] > .menu-summary::before {
  transform: translateY(-50%) rotate(90deg);
}

.menu-list {
  margin-top: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: .75rem;
}

.menu-item summary {
  position: relative;
  padding-left: 1.4rem;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: .75rem;
  color: #3a2818;
  font-weight: 500;
}

.menu-item summary::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  border-top: 4px solid transparent;
  border-bottom: 4px solid transparent;
  border-left: 6px solid #7a5a3a;
  transition: transform .2s ease;
}

.menu-item[open] summary::before {
  transform: translateY(-50%) rotate(90deg);
}

.menu-desc {
  margin-top: .45rem;
  margin-left: .75rem;
  padding-left: .75rem;
  font-size: .9rem;
  font-style: italic;
  line-height: 1.5;
  color: #5a4634;
  border-left: 2px solid rgba(90,70,52,.25);
}
</style>
<script>
  const carousel = document.getElementById("carousel");
  const items = Array.from(carousel.querySelectorAll(".carousel-item"));
  const total = items.length;

  let activeIndex = Math.floor(total / 2);

  function distance() {
    return window.innerWidth < 640 ? 140 : 260;
  }

  function getOffset(index) {
    let diff = index - activeIndex;

    // 🔁 WRAP AROUND (THIS MAKES IT INFINITE)
    if (diff > total / 2) diff -= total;
    if (diff < -total / 2) diff += total;

    return diff;
  }

  function update() {
    const d = distance();

    items.forEach((item, i) => {
      const offset = getOffset(i);
      const abs = Math.abs(offset);

      item.style.transform =
        `translateX(${offset * d}px) scale(${offset === 0 ? 1 : 0.82})`;

      item.style.opacity = abs > 2 ? "0" : offset === 0 ? "1" : "0.45";
      item.style.filter = offset === 0 ? "brightness(1)" : "brightness(.7)";
      item.style.zIndex = 20 - abs;
      item.style.pointerEvents = offset === 0 ? "none" : "auto";
    });
  }

  // CLICK
  items.forEach((item, i) =>
    item.addEventListener("click", () => {
      activeIndex = i;
      update();
    })
  );

  // TOUCH (INFINITE)
  let startX = null;
  let startY = null;
  let isHorizontal = null;

  carousel.addEventListener("touchstart", (e) => {
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
    isHorizontal = null;
  }, { passive: true });

  carousel.addEventListener("touchmove", (e) => {
    if (startX == null || startY == null) return;

    const dx = e.touches[0].clientX - startX;
    const dy = e.touches[0].clientY - startY;

    if (isHorizontal === null) {
      isHorizontal = Math.abs(dx) > Math.abs(dy);
    }

    if (isHorizontal) e.preventDefault();
  }, { passive: false });

  carousel.addEventListener("touchend", (e) => {
    if (!isHorizontal || startX == null) {
      startX = startY = null;
      return;
    }

    const diff = startX - e.changedTouches[0].clientX;

    if (diff > 50) {
      // swipe left → next
      activeIndex = (activeIndex + 1) % total;
    } else if (diff < -50) {
      // swipe right → prev
      activeIndex = (activeIndex - 1 + total) % total;
    }

    update();
    startX = startY = isHorizontal = null;
  });

  window.addEventListener("resize", update);
  update();
</script>
