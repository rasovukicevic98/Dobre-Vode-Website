---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="Meni – Dobre Vode">
  <Header />

  <main class="mt-12 mb-24 px-4">
    <section
      class="
        relative
        w-full
        max-w-sm
        sm:max-w-md
        md:max-w-lg
        lg:max-w-xl
        xl:max-w-2xl
        mx-auto
        rounded-xl
        bg-[#f3e6cf]
        shadow-[0_20px_70px_rgba(0,0,0,0.6)]
        border
        border-black/10
      "
    >
      <!-- NAILS -->
      <span class="absolute top-3 left-3 w-3 h-3 rounded-full bg-[#4b4b4b] shadow-[inset_0_1px_1px_rgba(255,255,255,0.4),0_2px_4px_rgba(0,0,0,0.6)]"></span>
      <span class="absolute top-3 right-3 w-3 h-3 rounded-full bg-[#4b4b4b] shadow-[inset_0_1px_1px_rgba(255,255,255,0.4),0_2px_4px_rgba(0,0,0,0.6)]"></span>
      <span class="absolute bottom-3 left-3 w-3 h-3 rounded-full bg-[#4b4b4b] shadow-[inset_0_1px_1px_rgba(255,255,255,0.4),0_2px_4px_rgba(0,0,0,0.6)]"></span>
      <span class="absolute bottom-3 right-3 w-3 h-3 rounded-full bg-[#4b4b4b] shadow-[inset_0_1px_1px_rgba(255,255,255,0.4),0_2px_4px_rgba(0,0,0,0.6)]"></span>

      <div class="px-8 sm:px-10 md:px-12 lg:px-16 py-16 sm:py-20">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif tracking-wide text-[#2a1d13] text-center mb-16">
          Meni
        </h1>

        <!-- TEMPLATE NOTE:
             Each category is a <details> block with <summary>
             Arrow + animation handled globally in <style> below
        -->

        <!-- ======================= DORUČAK ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Doručak</summary>
          <ul class="menu-list">
            <li><span>Popara</span><span>3.60 €</span></li>
            <li><span>Pita domaća</span><span>3.70 €</span></li>
            <li><span>Priganice</span><span>3.80 €</span></li>
            <li><span>Jaje na oko</span><span>2.10 €</span></li>
            <li><span>Kajgana</span><span>2.10 €</span></li>
            <li><span>Omlet sa pizza šunkom</span><span>3.30 €</span></li>
            <li><span>Omlet sa svinjskom pršutom</span><span>3.80 €</span></li>
            <li><span>Omlet sa goveđom pršutom</span><span>4.20 €</span></li>
            <li><span>Omlet sa sirom</span><span>3.30 €</span></li>
            <li><span>Omlet sa slaninom</span><span>3.30 €</span></li>
            <li><span>Omlet sa povrćem</span><span>3.20 €</span></li>
            <li><span>Hemendex (3 jaja, šunka)</span><span>3.30 €</span></li>
            <li><span>Bekendex (3 jaja, slanina)</span><span>3.30 €</span></li>
            <li><span>Kuvano jaje</span><span>1.40 €</span></li>
            <li><span>Slane palačinke</span><span>3.20 €</span></li>
          </ul>
        </details>

        <!-- ======================= SUPE I ČORBE ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Supe i čorbe</summary>
          <ul class="menu-list">
            <li><span>Pileća supa</span><span>2.20 €</span></li>
            <li><span>Teleća čorba</span><span>2.60 €</span></li>
            <li><span>Riblja čorba</span><span>2.80 €</span></li>
          </ul>
        </details>

        <!-- ======================= RIBA ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Riba</summary>
          <ul class="menu-list">
            <li><span>Pastrmka na žaru</span><span>7.90 €</span></li>
            <li><span>Pastrmka punjena kajmakom</span><span>9.60 €</span></li>
            <li><span>Dimljena pastrmka (bez kostiju)</span><span>12.70 €</span></li>
          </ul>
        </details>

        <!-- ======================= SENDVIČI ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Sendviči</summary>
          <ul class="menu-list">
            <li><span>Sendvič sa pizza šunkom</span><span>3.40 €</span></li>
            <li><span>Sendvič sa svinjskom pršutom</span><span>3.90 €</span></li>
            <li><span>Sendvič sa goveđom pršutom</span><span>4.30 €</span></li>
            <li><span>Sendvič sa sirom</span><span>3.10 €</span></li>
            <li><span>Sendvič sa kajmakom</span><span>3.20 €</span></li>
            <li><span>Hamburger</span><span>4.50 €</span></li>
          </ul>
        </details>

        <!-- ======================= HLADNA PREDJELA ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Hladna predjela</summary>
          <ul class="menu-list">
            <li><span>Ordever Dobre Vode</span><span>9.50 €</span></li>
            <li><span>Njeguška pršuta</span><span>6.80 €</span></li>
            <li><span>Goveđa pršuta</span><span>7.50 €</span></li>
            <li><span>Kolašinski lisnati sir</span><span>4.20 €</span></li>
            <li><span>Domaći kajmak</span><span>3.80 €</span></li>
            <li><span>Kiselo mlijeko</span><span>2.00 €</span></li>
            <li><span>Slatko mlijeko</span><span>1.80 €</span></li>
          </ul>
        </details>

        <!-- ======================= TOPLA PREDJELA ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Topla predjela</summary>
          <ul class="menu-list">
            <li><span>Pohovani sir</span><span>4.60 €</span></li>
            <li><span>Grilovano povrće</span><span>4.20 €</span></li>
          </ul>
        </details>

        <!-- ======================= GOTOVA JELA ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Gotova jela</summary>
          <ul class="menu-list">
            <li><span>Jagnjetina na pari</span><span>11.90 €</span></li>
            <li><span>Teleći ribić na kajmaku</span><span>10.80 €</span></li>
            <li><span>Juneći gulaš</span><span>7.90 €</span></li>
            <li><span>Škembići u saftu</span><span>6.90 €</span></li>
            <li><span>Kastradina</span><span>8.50 €</span></li>
            <li><span>Koljenice</span><span>9.90 €</span></li>
          </ul>
        </details>

        <!-- ======================= SPECIJALITETI ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Specijaliteti restorana</summary>
          <ul class="menu-list">
            <li><span>Specijalitet Dobre Vode</span><span>14.90 €</span></li>
            <li><span>Sablja na žaru</span><span>16.50 €</span></li>
          </ul>
        </details>

        <!-- ======================= DOMAĆI SPECIJALITETI ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Domaći specijaliteti</summary>
          <ul class="menu-list">
            <li><span>Jagnjetina u varenici</span><span>13.50 €</span></li>
            <li><span>Kačamak – krompirov</span><span>4.50 €</span></li>
            <li><span>Cicvara – gotovac</span><span>5.20 €</span></li>
            <li><span>Meso na seljački način</span><span>9.80 €</span></li>
            <li><span>Domaća lepinja</span><span>1.20 €</span></li>
            <li><span>Proja</span><span>1.50 €</span></li>
            <li><span>Ražani hljeb</span><span>1.40 €</span></li>
          </ul>
        </details>

        <!-- ======================= JELA PO PORUDŽBINI ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Jela po porudžbini</summary>
          <ul class="menu-list">
            <li><span>Popeci na podgorički način</span><span>8.90 €</span></li>
            <li><span>Bečka šnicla</span><span>8.20 €</span></li>
            <li><span>Karađorđeva šnicla</span><span>9.50 €</span></li>
            <li><span>Karađorđeva šnicla mala</span><span>7.50 €</span></li>
            <li><span>Pohovana teletina</span><span>9.20 €</span></li>
          </ul>
        </details>

        <!-- ======================= ROŠTILJ ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Jela sa roštilja</summary>
          <ul class="menu-list">
            <li><span>Dimljena vešalica</span><span>8.90 €</span></li>
            <li><span>Bijela vešalica</span><span>8.50 €</span></li>
            <li><span>Dimljena bijela vešalica</span><span>9.20 €</span></li>
            <li><span>Punjena vešalica</span><span>9.80 €</span></li>
            <li><span>Rolovana vešalica</span><span>9.60 €</span></li>
            <li><span>Ražnjići na žaru</span><span>7.80 €</span></li>
            <li><span>Punjeni ražnjići</span><span>8.50 €</span></li>
            <li><span>Gurmanska pljeskavica</span><span>7.20 €</span></li>
            <li><span>Dimljena kobasica</span><span>6.80 €</span></li>
            <li><span>Rolovani pileći ražnjići u slanini</span><span>8.40 €</span></li>
            <li><span>Gurmanski uštipci</span><span>7.00 €</span></li>
            <li><span>Svinjski vrat</span><span>7.50 €</span></li>
            <li><span>Punjeni bataci</span><span>7.90 €</span></li>
            <li><span>Biftek na žaru</span><span>16.90 €</span></li>
            <li><span>Slanina na žaru</span><span>5.50 €</span></li>
          </ul>
        </details>

        <!-- ======================= PRILOZI ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Prilozi</summary>
          <ul class="menu-list">
            <li><span>Šampinjon sos</span><span>2.20 €</span></li>
            <li><span>Kisela pavlaka</span><span>1.80 €</span></li>
            <li><span>Kuvani krompir</span><span>2.50 €</span></li>
            <li><span>Pomfrit</span><span>2.80 €</span></li>
            <li><span>4 vrste sira</span><span>4.50 €</span></li>
            <li><span>Dalmatinsko varivo</span><span>3.80 €</span></li>
          </ul>
        </details>

        <!-- ======================= SALATE ======================= -->
        <details class="menu-group">
          <summary class="menu-summary">Salate</summary>
          <ul class="menu-list">
            <li><span>Šopska salata</span><span>3.20 €</span></li>
            <li><span>Srpska salata</span><span>3.10 €</span></li>
            <li><span>Bašta – vitaminska salata</span><span>3.50 €</span></li>
            <li><span>Krastavac</span><span>2.20 €</span></li>
            <li><span>Paradajz</span><span>2.20 €</span></li>
          </ul>
        </details>

      </div>
    </section>
  </main>
</BaseLayout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .menu-group {
    margin-bottom: 3rem;
  }

  .menu-summary {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 1.5rem;
    font-family: serif;
    color: #2a1d13;
  }

  .menu-summary::after {
    content: "▾";
    font-size: 1.4rem;
    color: #5b3a1e;
    transition: transform 0.25s ease;
  }

  details[open] .menu-summary::after {
    transform: rotate(180deg);
  }

  .menu-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    color: #3a2818;
  }

  .menu-list li span:last-child {
    white-space: nowrap;
    font-weight: 500;
  }
</style>
