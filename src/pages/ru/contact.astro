---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { translations } from "../i18n/translations";
---

<BaseLayout title="Kontakt – Dobre Vode">
  <Header  />

  <main class="mt-12 mb-24 px-4">
    <!-- CONTACT CARD -->
    <section
      class="
        relative w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl xl:max-w-2xl
        mx-auto rounded-xl bg-[#f3e6cf]
        shadow-[0_20px_70px_rgba(0,0,0,0.6)]
        border border-black/10 text-center
      "
    >
      <div class="px-8 sm:px-10 md:px-12 lg:px-16 py-16 sm:py-20">
        <h1
          id="title"
          class="text-3xl sm:text-4xl lg:text-5xl mb-14 tracking-wide text-[#7a1f1f]"
        >
          Kontakt
        </h1>

        <div class="space-y-8 text-[#3a2818] text-lg">
          <div>
            <p id="phoneLabel" class="font-semibold mb-1">Telefon</p>
            <a href="tel:+38267233000">+382 67 233 000</a>
          </div>

          <div>
            <p id="emailLabel" class="font-semibold mb-1">Email</p>
            <a href="mailto:dobrevodekolasin@gmail.com">
              dobrevodekolasin@gmail.com
            </a>
          </div>

          <div>
            <p id="locationLabel" class="font-semibold mb-4">Lokacija</p>
            <iframe
              class="w-full h-[300px] rounded-lg"
              src="https://www.google.com/maps?q=42.88834376187423,19.53937941335553&z=15&output=embed"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- LANGUAGE SCRIPT -->
    <script is:inline>
  const TRANSLATIONS = JSON.parse(
    `${JSON.stringify(translations)}`
  );

  const lang = localStorage.getItem("lang") || "me";
  const t = TRANSLATIONS[lang].contact;

  document.getElementById("title").textContent = t.title;
  document.getElementById("phoneLabel").textContent = t.phone;
  document.getElementById("emailLabel").textContent = t.email;
  document.getElementById("locationLabel").textContent = t.location;
</script>

  </main>
</BaseLayout>
