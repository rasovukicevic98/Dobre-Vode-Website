---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { menu } from "../../data/menuData";
import { menuTranslations } from "../../i18n/menu";

const { lang } = Astro.params;
const t = menuTranslations[lang] ?? menuTranslations.me;

/* SPLIT MENU DATA */
const foodCategoryIds = Object.keys(t.categories);
const drinkCategoryIds = Object.keys(t.drinkCategories);

const foodCategories = menu.filter(c => foodCategoryIds.includes(c.id));
const drinkCategories = menu.filter(c => drinkCategoryIds.includes(c.id));
---

<BaseLayout title={t.title}>
  <Header />

  <main class="mt-12 mb-24 px-4">
    <section
      class="relative w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl xl:max-w-2xl
             mx-auto rounded-xl bg-[#f3e6cf]
             shadow-[0_20px_70px_rgba(0,0,0,0.6)]
             border border-black/10"
    >
      <div class="px-8 sm:px-10 md:px-12 lg:px-16 py-16 sm:py-20">

        <!-- TITLE -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif tracking-wide
                   text-[#7a1f1f] text-center mb-12">
          {t.title}
        </h1>

        <!-- ======================= IZDVAJAMO ======================= -->
        <h2 class="text-xl font-serif tracking-wide text-[#2a1d13] text-center mb-6">
          {t.spotlight}
        </h2>

        <!-- ======================= CAROUSEL ======================= -->
        <div class="spotlight-carousel" id="carousel">
          <div class="carousel-item">
            <img src="/images/spec1.jpg" alt="" />
            <div class="carousel-caption">{t.items.dobreVodeSpecialty.name}</div>
          </div>

          <div class="carousel-item">
            <img src="/images/kolasinskistek.jpeg" alt="" />
            <div class="carousel-caption">{t.items.kolasinSteak.name}</div>
          </div>

          <div class="carousel-item">
            <img src="/images/telecepecenje.jpeg" alt="" />
            <div class="carousel-caption">{t.items.roastedVeal.name}</div>
          </div>

          <div class="carousel-item">
            <img src="/images/kacamak.jpeg" alt="" />
            <div class="carousel-caption">{t.items.potatoKacamak.name}</div>
          </div>

          <div class="carousel-item">
            <img src="/images/cicvara.jpeg" alt="" />
            <div class="carousel-caption">{t.items.cicvara.name}</div>
          </div>
        </div>

        <!-- ================= FOOD ================= -->
        <details class="top-group">
          <summary class="top-summary">
            🍽️ {t.ui.food}
          </summary>

          {foodCategories.map(category => (
            <details class="menu-group">
              <summary class="menu-summary">
                {t.categories[category.id]}
              </summary>

              <ul class="menu-list">
                {category.items.map(item => {
                  const itemT = t.items[item.id];

                  return (
                    <details class="menu-item">
                      <summary>
                        <span>
                          {itemT.name}
                          {item.portion && <small> ({item.portion})</small>}
                        </span>
                        <span>{item.price.toFixed(2)} €</span>
                      </summary>

                      {(itemT.desc || itemT.img) && (
                        <div class="menu-desc">
                          {itemT.desc && <p>{itemT.desc}</p>}
                          {itemT.img && (
                            <img
                              src={itemT.img}
                              alt={itemT.name}
                              class="menu-img"
                            />
                          )}
                        </div>
                      )}
                    </details>
                  );
                })}
              </ul>
            </details>
          ))}
        </details>

        <!-- ================= DRINKS ================= -->
        <details class="top-group mt-16">
          <summary class="top-summary">
            🍷 {t.ui.drinks}
          </summary>

          {drinkCategories.map(category => (
            <details class="menu-group">
              <summary class="menu-summary">
                {t.drinkCategories[category.id]}
              </summary>

              <ul class="menu-list">
                {category.items.map(item => {
                  const itemT = t.items[item.id];

                  return (
                    <li class="menu-drink">
                      <span>
                        {itemT.name}
                        {item.portion && <small> ({item.portion})</small>}
                      </span>
                      <span>{item.price.toFixed(2)} €</span>
                    </li>
                  );
                })}
              </ul>
            </details>
          ))}
        </details>

      </div>
    </section>
  </main>
</BaseLayout>

<style>
/* =================== CAROUSEL =================== */
.spotlight-carousel {
  position: relative;
  height: 390px;
  margin-bottom: 4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.carousel-item {
  position: absolute;
  transition: transform .45s ease, opacity .45s ease, filter .45s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.carousel-item img {
  width: 240px;
  height: 320px;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 18px 40px rgba(0,0,0,.45);
  user-select: none;
  pointer-events: none;
}

.carousel-caption {
  margin-top: .75rem;
  font-family: serif;
  font-size: .95rem;
  color: #2a1d13;
  opacity: .9;
}

/* ================= TOP LEVEL ================= */
.top-summary {
  text-align: center;
  font-family: serif;
  font-size: 1.9rem;
  color: #2a1d13;
  cursor: pointer;
  margin-bottom: 2rem;
}

/* ================= MENU ================= */
summary { list-style: none; cursor: pointer; }
summary::-webkit-details-marker { display: none; }

.menu-group { margin-bottom: 2.5rem; }

.menu-summary {
  position: relative;
  padding-left: 2rem;
  font-size: 1.4rem;
  font-family: serif;
  color: #2a1d13;
}

.menu-summary::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  border-top: 7px solid transparent;
  border-bottom: 7px solid transparent;
  border-left: 10px solid #5b3a1e;
}

.menu-list {
  margin-top: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: .75rem;
}

.menu-item summary {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: .75rem;
  padding-left: 1.4rem;
}

.menu-desc {
  margin-left: .75rem;
  padding-left: .75rem;
  font-size: .9rem;
  font-style: italic;
  border-left: 2px solid rgba(90,70,52,.25);
}

.menu-img {
  margin-top: .6rem;
  max-width: 100%;
  border-radius: .5rem;
}

.menu-drink {
  display: grid;
  grid-template-columns: 1fr auto;
  padding-left: 1.4rem;
}
</style>

<script>
  const carousel = document.getElementById("carousel");
  const items = [...carousel.querySelectorAll(".carousel-item")];
  let activeIndex = Math.floor(items.length / 2);

  function distance() {
    return window.innerWidth < 640 ? 140 : 260;
  }

  function update() {
    const d = distance();
    items.forEach((item, i) => {
      const offset = i - activeIndex;
      item.style.transform =
        `translateX(${offset * d}px) scale(${offset === 0 ? 1 : .82})`;
      item.style.opacity = offset === 0 ? "1" : "0.45";
      item.style.filter = offset === 0 ? "brightness(1)" : "brightness(.7)";
      item.style.zIndex = offset === 0 ? "20" : "10";
    });
  }

  items.forEach((item, i) =>
    item.addEventListener("click", () => {
      activeIndex = i;
      update();
    })
  );

  window.addEventListener("resize", update);
  update();
</script>
